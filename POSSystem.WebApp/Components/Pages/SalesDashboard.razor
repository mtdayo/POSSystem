@page "/SalesDashboard"

@using Microsoft.AspNetCore.Authorization
@using POSSystem.Domain.Entities
@using POSSystem.Domain.Enums
@using POSSystem.Infrastructure.Repositories
@using POSSystem.WebApp.Models
@using POSSystem.WebApp.Services
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "Employee")]

@* @implements IAsyncDisposable *@

@inject SaleRepository SaleRepository
@inject SalesService SaleService
@inject IJSRuntime JS

<PageTitle>売上管理</PageTitle>

<h3>売上管理</h3>

<div class="btn-group mb-3">
    <button class="btn @(selectedPeriod == "Today" ? "btn-primary" : "btn-outline-primary")"
            @onclick='() => ChangePeriod("Today")'>
        今日
    </button>

    <button class="btn @(selectedPeriod == "Month" ? "btn-primary" : "btn-outline-primary")"
            @onclick='() => ChangePeriod("Month")'>
        今月
    </button>

    <button class="btn @(selectedPeriod == "FiscalYear" ? "btn-primary" : "btn-outline-primary")"
            @onclick='() => ChangePeriod("Year")'>
        今年
    </button>
</div>

@if (isLoading)
{
    <p>読み込み中...</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>注文番号</th>
                    <th>購入日時</th>
                    <th>売上金額</th>
                    <th>支払方法</th>
                </tr>
            </thead>
            <tbody>
                @if (sales.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            売上データがありません。
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sale in DisplayedSales)
                    {
                        <tr>
                            <td>
                                <a href="@($"/PurchaseHistory?SaleId={sale.Id}")">
                                    @sale.Id
                                </a>
                            </td>
                            <td>@sale.SaleDate.ToString("yyyy/MM/dd HH:mm:ss")</td>
                            <td>@sale.TotalAmount.ToString("C0")</td>
                            <td>@GetPaymentName(sale.Payment)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (sales.Count > 0)
        {
            <nav aria-label="売上一覧ページ">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link"
                        disabled="@(currentPage == 1)"
                        @onclick="PreviousPage">
                            前へ
                        </button>
                    </li>

                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        int page = i;

                        <li class="page-item @(currentPage == page ? "active" : "")">
                            <button class="page-link"
                            @onclick="() => ChangePage(page)">
                                @(page)
                            </button>
                        </li>
                    }

                    <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                        <button class="page-link"
                        disabled="@(currentPage == TotalPages)"
                        @onclick="NextPage">
                            次へ
                        </button>
                    </li>
                </ul>
            </nav>

            <p class="text-center text-muted">
                @sales.Count 件中
                @((currentPage - 1) * pageSize + 1)
                ～
                @Math.Min(currentPage * pageSize, sales.Count)件を表示
            </p>
        }
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label>並び替え項目</label>
            <select class="form-select" @bind="productSortType">
                <option value="code">商品コード</option>
                <option value="name">商品名</option>
                <option value="quantity">売上個数</option>
                <option value="sales">売上金額</option>
            </select>
        </div>

        <div class="col-md-4">
            <label>並び順</label>
            <select class="form-select" @bind="productSortOrder">
                <option value="asc">昇順</option>
                <option value="desc">降順</option>
            </select>
        </div>

        <div class="col-md-4">
            <label>表示件数</label>
            <select class="form-select" @bind="productSalesPageSize"
                    @bind:after="ResetProductSalesPage">
                <option value="5">5件</option>
                <option value="10">10件</option>
                <option value="20">20件</option>
                <option value="50">50件</option>
                <option value="100">100件</option>
            </select>
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input"
                type="checkbox"
                id="showZeroSales"
                @bind="showZeroSales" />

        <label class="form-check-label" for="showZeroSales">
            売上個数0の商品を表示する
        </label>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5>商品別売上集計</h5>

            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>商品コード</th>
                            <th>商品名</th>
                            <th>売上個数</th>
                            <th>売上金額</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (productSales.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center">
                                    商品データがありません
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in DisplayedProductSales)
                            {
                                <tr>
                                    <td>@item.ProductCode</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.TotalQuantity.ToString("N0")個</td>
                                    <td>@item.TotalSales.ToString("C0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if(SortedProductSales.Any())
                {
                    <nav aria-label="商品別売上">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(productSalesCurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link"
                                        disabled="@(productSalesCurrentPage == 1)"
                                        @onclick="PreviousProductSalesPage">
                                    前へ
                                </button>
                            </li>

                            @for (int i = 1; i <= ProductSalesTotalPages; i++)
                            {
                                int page = i;

                                <li class="page-item @(productSalesCurrentPage == page ? "active" : "")">
                                    <button class="page-link"
                                            @onclick="() => ChangeProductSalesPage(page)">
                                        @(page)
                                    </button>
                                </li>
                            }

                            <li class="page-item @(productSalesCurrentPage == ProductSalesTotalPages ? "disabled" : "")">
                                <button class="page-link"
                                        disabled="@(productSalesCurrentPage == ProductSalesTotalPages)"
                                        @onclick="NextProductSalesPage">
                                    次へ
                                </button>
                            </li>
                        </ul>
                    </nav>

                    <p class="text-center text-muted">
                        @SortedProductSales.Count() 件中
                        @((productSalesCurrentPage - 1) * productSalesPageSize + 1)
                        ～
                        @Math.Min(productSalesCurrentPage * productSalesPageSize, SortedProductSales.Count())件を表示
                    </p>
                }
            </div>
        </div>
    </div>

    @* <div class="card mt-3" id="sales-summary">
        <div class="card-body">
            <h5>売上集計</h5>

            <h4>
                売上合計:
                <span class="text-primary">
                    @GetCurrentSales().ToString("C0")
                </span>
            </h4>

            <p>
                比較対象売上:
                @GetPreviousSales().ToString("C0")
            </p>

            <p>
                増減率:
                <span class="@(GetGrowthRate() >= 0 ? "text-success" : "text-danger")">
                    @(GetGrowthRate() >= 0 ? "+" : "")@GetGrowthRate().ToString("N1")%
                </span>
            </p>
        </div>
    </div> *@

    @* @if (showFloatingSummary)
    {
        <div class="sales-summary-fixed">
            <div class="card shadow">
                <div class="card-body">
                    <h6>売上集計</h6>
                    <p class="mb-1">
                        売上合計: @GetCurrentSales().ToString("C0")
                    </p>

                    <p class="mb-1">
                        比較対象売上: @GetPreviousSales().ToString("C0")
                    </p>

                    <p class="mb-0">
                        増減率: @GetGrowthRate().ToString("N1")%
                    </p>
                </div>
            </div>
        </div>
    } *@

    <div class="card mt-3">
        <div class="card-body">
            <h5>売上集計</h5>

            <h4>
                売上合計:
                <span class="text-primary">
                    @GetCurrentSales().ToString("C0")
                </span>
            </h4>

            <p>
                比較対象売上:
                @GetPreviousSales().ToString("C0")
            </p>

            <p>
                増減率:
                <span class="@(GetGrowthRate() >= 0 ? "text-success" : "text-danger")">
                    @(GetGrowthRate() >= 0 ? "+" : "")@GetGrowthRate().ToString("N1")%
                </span>
            </p>
        </div>
    </div>
}

@code {
    private bool showFloatingSummary = false;
    private DotNetObjectReference<SalesDashboard>? dotNetHelper;


    private string selectedPeriod = "Today";
    private bool isLoading = true;
    private List<Sale> sales = new();
    private SalesSummary summary = new();

    private int pageSize = 10;
    private int currentPage = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)sales.Count / pageSize));

    private IEnumerable<Sale> DisplayedSales => sales.Skip((currentPage - 1) * pageSize)
                                                     .Take(pageSize);

    private List<ProductSalesSummary> productSales = new();

    //商品別の売上のソート
    private string productSortType = "code";
    private string productSortOrder = "asc";

    //ソート後の商品別売上
    private IEnumerable<ProductSalesSummary> SortedProductSales
    {
        get
        {
            //売上個数0の商品を除外
            IEnumerable<ProductSalesSummary> result = showZeroSales ? productSales : productSales.Where(x => x.TotalQuantity > 0);
            return productSortType switch
            {
                "name" => productSortOrder == "asc" ? result.OrderBy(x => x.ProductName) : result.OrderByDescending(x => x.ProductName),
                "quantity" => productSortOrder == "asc" ? result.OrderBy(x => x.TotalQuantity) : result.OrderByDescending(x => x.TotalQuantity),
                "sales" => productSortOrder == "asc" ? result.OrderBy(x => x.TotalSales) : result.OrderByDescending(x => x.TotalSales),
                _ => productSortOrder == "asc" ? result.OrderBy(x => x.ProductCode) : result.OrderByDescending(x => x.ProductCode)
            };
        }
    }

    //ページング後の商品別売り上げ
    private IEnumerable<ProductSalesSummary> DisplayedProductSales =>
            SortedProductSales.Skip((productSalesCurrentPage - 1) * productSalesPageSize)
                              .Take(productSalesPageSize);

    //商品別売上の総ページ数
    private int ProductSalesTotalPages => Math.Max(1, (int)Math.Ceiling((double)SortedProductSales.Count() / productSalesPageSize));

    //売上個数0の商品を表示する
    private bool showZeroSales = true;

    private int productSalesPageSize = 10;
    private int productSalesCurrentPage = 1;

    protected override void OnInitialized()
    {
        LoadSales();
    }

    private void ChangePeriod(string period)
    {
        selectedPeriod = period;

        currentPage = 1;

        LoadSales();
    }

    private void LoadSales()
    {
        isLoading = true;

        DateTime now = DateTime.Now;

        DateTime startDate;
        DateTime endDate = now.AddSeconds(1);

        switch(selectedPeriod)
        {
            case "Today":
                startDate = now.Date;
                break;

            case "Month":
                startDate = new DateTime(now.Year, now.Month, 1);
                break;

            case "Year":
                startDate = now.Month >= 4 ? new DateTime(now.Year, 4, 1) : new DateTime(now.Year - 1, 4, 1);
                break;

            default:
                startDate = now.Date;
                break;
        }

        sales = SaleRepository.GetSalesByPeriod(startDate, endDate)
                              .ToList();

        productSales = SaleRepository.GetProductSalesSummary(startDate, endDate)
                                 .ToList();

        summary = SaleService.GetSalesSummary();

        isLoading = false;
    }

    private decimal GetCurrentSales()
    {
        return selectedPeriod switch
        {
            "Today" => summary.TodaySales,
            "Month" => summary.MonthlySales,
            "Year" => summary.FiscalYearSales,
            _ => 0
        };
    }

    private decimal GetPreviousSales()
    {
        return selectedPeriod switch
        {
            "Today" => summary.YesterdaySales,
            "Month" => summary.PreviousMonthSales,
            "Year" => summary.PreviousFiacalYearSales,
            _ => 0
        };
    }

    private decimal GetGrowthRate()
    {
        return selectedPeriod switch
        {
            "Today" => summary.TodayGrowthRate,
            "Month" => summary.MonthlyGrowthRate,
            "Year" => summary.FiscalYearGrowthRate,
            _ => 0
        };
    }

    private string GetPaymentName(Payment payment)
    {
        return payment switch
        {
            Payment.Cash => "現金",
            Payment.CreditCard => "クレジットカード",
            Payment.ElectronicMoney => "電子マネー",
            _ => "その他"
        };
    }

    private void ChangePage(int page)
    {
        if(page < 0 || page > TotalPages)
        {
            return;
        }

        currentPage = page;
    }

    private void PreviousPage()
    {
        if(currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void ChangeProductSalesPage(int page)
    {
        if (page < 1 || page > ProductSalesTotalPages)
        {
            return;
        }

        productSalesCurrentPage = page;
    }

    private void PreviousProductSalesPage()
    {
        if (productSalesCurrentPage > 1)
        {
            productSalesCurrentPage--;
        }
    }

    private void NextProductSalesPage()
    {
        if(productSalesCurrentPage < ProductSalesTotalPages)
        {
            productSalesCurrentPage++;
        }
    }

    private void ResetProductSalesPage()
    {
        productSalesCurrentPage = 1;
    }

