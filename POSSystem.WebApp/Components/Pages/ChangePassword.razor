@page "/ChangePassword"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using POSSystem.Application.Services

@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccountService AccountService
@inject NavigationManager Navigation

<PageTitle>パスワード変更</PageTitle>

<h3>パスワード変更</h3>

<div class="password-form">
    <div class="mb-3">
        <label for="currentPassword" class="form-label">
            現在のパスワード
        </label>
        <input id="currentPassword"
               type="password"
               class="form-control"
               @bind="currentPassword"
               autocomplete="current-password" />
    </div>

    <div class="mb-3">
        <label for="newPassword" class="form-label">
            新しいパスワード
        </label>
        <input id="newPassword"
               type="password"
               class="form-control"
               @bind="newPassword"
               autocomplete="new-password" />
    </div>

    <div class="mb-3">
        <label for="confirmPassword" class="form-label">
            新しいパスワード (確認)
        </label>
        <input id="confirmPassword"
               type="password"
               class="form-control"
               @bind="confirmPassword"
               autocomplete="new-password" />
    </div>

    @if(!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

    <button class="btn btn-primary"
            @onclick="ChangePasswordAsync"
            didabled="@isSubmitting">
        @(isSubmitting ? "変更中..." : "パスワードを変更")
    </button>

    <button class="btn btn-secondary ms-2"
            @onclick="BackToMyPage"
            disabled="@isSubmitting">
        戻る
    </button>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    private string? message;
    private bool isSuccess;
    private bool isSubmitting;


    private async Task ChangePasswordAsync()
    {
        if(isSubmitting)
        {
            return;
        }

        message = null;
        isSuccess = false;

        //新しいパスワードの確認
        if(newPassword != confirmPassword)
        {
            message = "新しいパスワードが一致しません。";
            return;
        }

        try
        {
            //ログイン状態を取得
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if(user.Identity?.IsAuthenticated != true)
            {
                message = "ログインしてください。";
                return;
            }

            //ログイン中のユーザーIDを取得
            var accountIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if(!int.TryParse(accountIdValue, out int accountId))
            {
                message = "アカウント情報を取得できせんでした。";
                return;
            }

            isSubmitting = true;

            //パスワード変更処理
            AccountService.ChangePassword(accountId, currentPassword, newPassword);

            isSuccess = true;
            message = "パスワード変更しました。";

            //入力内容クリア
            currentPassword = "";
            newPassword = "";
            confirmPassword = "";

        }
        catch (InvalidOperationException ex)
        {
            message = ex.Message;
        }
        catch(Exception ex)
        {
            message = $"パスワード変更に失敗しました。時間をおいて再度お試しください。{ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }

    }

    private void BackToMyPage()
    {
        Navigation.NavigateTo("/MyPage");
    }
}
