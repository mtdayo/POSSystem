@page "/login"

@using POSSystem.WebApp.Models
@using POSSystem.WebApp.Services

@using Microsoft.AspNetCore.Components

@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>ログイン</PageTitle>

<h1>ログイン</h1>

@if (Error)
{
    <div class="alert alert-danger">
        ユーザー名もしくはパスワードが正しくありません
    </div>
}

<form method="post" action="/auth/login">
    <AntiforgeryToken />
        <div class="mb-3">
            <label for="username" class="form-label">
                ユーザー名
            </label>

            <input id="username"
                   name="username"
                   type="text"
                   class="form-control"
                   autocomplete="username"
                   required />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">
                パスワード
            </label>

            <input id="password"
                   name="password"
                   type="password"
                   class="form-control"
                   autocomplete="current-password"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">
            ログイン
        </button>
</form>


@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    private bool Error => ErrorQuery == "1";
}
