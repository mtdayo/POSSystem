@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using POSSystem.WebApp.Models
@using POSSystem.WebApp.Services

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccountApiClient AccountApiClient
@inject BalanceStateService BalanceStateService


@inherits LayoutComponentBase

@implements IDisposable


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
        <AuthorizeView>

            <Authorized>

                @if (isGeneralUser)
                {
                    <a href="Purchase">カート</a>
                }
                    
                <a href="mypage">マイページ</a>
                
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                        <button type="submit" class="btn btn-link nav-link text-dark">
                            ログアウト
                        </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="login">ログイン</a>
                <a href="resister">会員登録</a>
            </NotAuthorized>

        </AuthorizeView>
        </div>

        @if(isGeneralUser && balance != null)
        {
            <div class="balance-row px-4">
                <span>
                    現金残高:
                    @balance.CashBalance.ToString("C0")
                </span>

                <span>
                    電子マネー残高:
                    @balance.ElectronicMoneyBalance.ToString("C0")
                </span>
            </div>
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isGeneralUser;

    private AccountBalance? balance;

    protected override async Task OnInitializedAsync()
    {
        BalanceStateService.OnChange += RefreshBalanceAsync;


        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        var employeeValue = user.FindFirst("isEmployee")?.Value;

        var token = user.FindFirst("api_access_token")?.Value;

        Console.WriteLine($"認証状態: {user.Identity?.IsAuthenticated}");
        Console.WriteLine($"IsEmployee: {employeeValue}");
        Console.WriteLine($"JWT存在: {!string.IsNullOrWhiteSpace(token)}");

        isGeneralUser = user.Identity?.IsAuthenticated == true &&
                        string.Equals(
                            employeeValue,
                            "false",
                            StringComparison.OrdinalIgnoreCase
                        );

        Console.WriteLine($"一般ユーザー判定: {isGeneralUser}");

        if (isGeneralUser)
        {
            await LoadBalanceAsync(user);
        }
    }

    private async Task LoadBalanceAsync(ClaimsPrincipal user)
    {
        var token = user.FindFirst("api_access_token")?.Value;

        if(string.IsNullOrWhiteSpace(token))
        {
            return;
        }

        balance = await AccountApiClient.GetBalanceAsync(token);
    }

    private async void RefreshBalanceAsync()
    {
        await InvokeAsync(async () =>
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            await LoadBalanceAsync(authState.User);

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        BalanceStateService.OnChange -= RefreshBalanceAsync;
    }

}